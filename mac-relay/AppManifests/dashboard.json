{
  "id": "dashboard",
  "name": "服务器面板",
  "detail": "NAS 状态",
  "icon": "",
  "capability": "dashboard",

  "keys": {
    "ok": { "click": "refresh" }
  },

  "screens": [
    {
      "title": "总览",
      "footer": "上下翻页  确定刷新",
      "rows": [
        { "when": { "cond": "!hasData",
                    "then": [ { "text": "{{status}}" } ],
                    "else": [
          { "bar": { "label": "CPU", "value": "cpuPercent" } },
          { "bar": { "label": "内存 {{memUsed}}/{{memTotal}}", "value": "memPercent" } },
          { "each": { "path": "disks", "limit": 4, "body": [
            { "bar": { "label": "{{item.label}} {{item.used}}/{{item.total}}",
                       "value": "item.usedPercent" } }
          ] } },
          { "spacer": true },
          { "text": "负载 {{load1|fixed:2}} / {{load5|fixed:2}} / {{load15|fixed:2}}" }
        ] } }
      ]
    },
    {
      "title": "下载",
      "footer": "上下翻页  确定刷新",
      "rows": [
        { "when": { "cond": "aria2OK",
                    "then": [
          { "text": "下行  {{downSpeed}}" },
          { "text": "上行  {{upSpeed}}" },
          { "spacer": true },
          { "text": "进行中   {{active}}" },
          { "text": "等待中   {{waiting}}" },
          { "text": "已完成   {{stopped}}" }
        ], "else": [ { "text": "下载器未运行" } ] } }
      ]
    },
    {
      "title": "媒体库",
      "footer": "上下翻页  确定刷新",
      "rows": [
        { "when": { "cond": "mediaOK",
                    "then": [
          { "text": "电影   {{movies}}" },
          { "text": "剧集   {{series}}" },
          { "text": "集数   {{episodes}}" },
          { "spacer": true },
          { "text": "正在播放   {{nowPlaying}}" }
        ], "else": [ { "text": "媒体库未运行" } ] } }
      ]
    },
    {
      "title": "网络",
      "footer": "上下翻页  确定刷新",
      "rows": [
        { "text": "节点" },
        { "text": "{{node|default:-}}" },
        { "spacer": true },
        { "text": "连接数   {{connections}}" },
        { "text": "累计上行 {{upTotalGB|fixed:1}} GB" },
        { "text": "累计下行 {{downTotalGB|fixed:1}} GB" },
        { "spacer": true },
        { "text": "Tailscale  {{tailscaleOK|pick:在线/离线}}" },
        { "text": "frp        {{frpOK|pick:已连接/断开}}" }
      ]
    },
    {
      "title": "容器",
      "footer": "上下翻页  确定刷新",
      "rows": [
        { "when": { "cond": "containers",
                    "then": [
          { "each": { "path": "containers", "limit": 10, "body": [
            { "text": "{{item.healthy|pick:+/x}} {{item.name}}" }
          ] } }
        ], "else": [ { "text": "没有容器" } ] } }
      ]
    }
  ]
}
