{
  "id": "meal",
  "name": "字节餐厅",
  "detail": "本周菜单与楼层推荐",
  "icon": "",
  "capability": "meal",
  "settings": "meal",

  "keys": {
    "up":   { "click": "prevPage", "hold": "prevDay" },
    "down": { "click": "nextPage", "hold": "nextDay" },
    "ok":   { "click": "togglePeriod" }
  },

  "screens": [
    {
      "title": "{{weekday|default:字节餐厅}} {{dateLabel}} {{period}} {{pageStatus}}",
      "footer": "单击翻页 长按换天 确定午晚",
      "rows": [
        { "when": { "cond": "!connected",
                    "then": [ { "text": "{{status}}" } ],
                    "else": [
          { "when": { "cond": "!hasMenu",
                      "then": [ { "text": "本周菜单还没更新" } ],
                      "else": [
            { "when": { "cond": "!hasDay",
                        "then": [
              { "text": "当日菜单未归档" },
              { "text": "{{date}}" }
            ], "else": [
              { "when": { "cond": "!hasPeriodMenu",
                          "then": [ { "text": "本餐暂无菜单" } ],
                          "else": [
                { "each": { "path": "menuRows", "limit": 9,
                            "body": [ { "text": "{{item}}", "style": "{{item.style}}" } ] } }
              ] } }
            ] } }
          ] } }
        ] } }
      ]
    }
  ]
}
